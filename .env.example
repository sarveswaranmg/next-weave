# PostgreSQL (must have the pgvector extension available - see docker-compose.yml)
DATABASE_URL=postgresql://neuroweave:neuroweave@localhost:5432/neuroweave
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis (used by Celery as broker/result backend, and for caching)
REDIS_URL=redis://localhost:6379/0

# OpenAI (required - used for embeddings regardless of chat provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (optional - only needed if you use provider="anthropic" in the runtime API/SDK)
ANTHROPIC_API_KEY=

# Google Gemini (default chat provider - free tier, no billing required).
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Application
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# Memory Settings
MEMORY_IMPORTANCE_THRESHOLD=0.3
MEMORY_RETRIEVAL_TOP_K=10
MEMORY_CONTEXT_TOKEN_LIMIT=2000

# Day 10: Cognitive Runtime Platform
# Multi-tenant auth: every /runtime/* request requires a valid, unrevoked
# X-API-Key belonging to a tenant (see neurowave_engine/db/models.py: Tenant, ApiKey).
# Bootstrap your first tenant + key with:
#   python scripts/bootstrap_tenant.py --name "My Company" --email me@example.com
# RUNTIME_API_KEY below is ONLY a one-time migration seed: if set the first
# time you run `alembic upgrade head`, migration 011 hashes it into an
# ApiKey for an auto-created tenant, so an old single-key deployment keeps
# working post-upgrade. It is not checked at request time afterward.
RUNTIME_API_KEY=
# Fernet key encrypting per-tenant BYOK provider credentials at rest
# (POST /runtime/credentials). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
RUNTIME_DEFAULT_PROVIDER=google
RUNTIME_DEFAULT_MODEL=gemini-2.0-flash

# Self-serve signup (GET/POST /signup, GET /signup/verify - see
# neurowave_engine/api/signup.py). Alternative to bootstrap_tenant.py: lets
# strangers create their own tenant + API key without you running anything.
SIGNUP_BASE_URL=http://localhost:8000
FREE_TIER_MONTHLY_CHAT_LIMIT=200
SIGNUP_MAX_PER_IP_PER_DAY=5
SIGNUP_TOKEN_TTL_HOURS=24
# SMTP for the verification email. Leave SMTP_HOST blank for local dev/test -
# the verification link is logged instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@neuroweave.local
SMTP_USE_TLS=true

# Note: dozens of additional tunable weights (decay rates, quality-score
# weights, thresholds for consolidation/forgetting/dream mode/world model)
# have sensible defaults in neurowave_engine/core/config.py and are documented in
# docs/DOCUMENTATION.md - only override them here if you know you need to.
