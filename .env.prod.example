# Production environment file for docker-compose.prod.yml.
# Copy to .env.prod on the SERVER ONLY (never commit the real file, never
# put it in CI) - see docs/DEPLOYMENT.md.

# A real domain whose DNS A record already points at this server's public
# IP - Caddy uses this to request a Let's Encrypt certificate automatically.
DOMAIN=neuroweave.yourdomain.com

# Postgres password - pick a strong random value, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=change_me

# OpenAI (required - used for embeddings regardless of chat provider).
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (optional - only needed if you use provider="anthropic")
ANTHROPIC_API_KEY=

# Google Gemini (default chat provider - free tier, no billing required -
# and the platform-wide fallback for tenants who haven't configured BYOK).
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# One-time migration seed only (see migrations/versions/011_multi_tenant_auth.py):
# if set the FIRST time you run migrations, it's hashed into an ApiKey for
# an auto-created tenant. Not checked at request time afterward - real
# auth is per-tenant via scripts/bootstrap_tenant.py from then on. Leave
# blank if you'd rather bootstrap your first tenant manually after deploy.
RUNTIME_API_KEY=

# Fernet key encrypting per-tenant BYOK provider credentials at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
